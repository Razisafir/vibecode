# ============================================================
# VibeCode Desktop — Preview/Staging Environment
# ============================================================
# SAFETY: This file is ONLY used when VIBECODE_ENV=preview or
# when running `npm run preview:start`. It is never auto-loaded.
# ============================================================

# ─── Application ───────────────────────────────────────────────
VIBECODE_ENV=preview
VIBECODE_CHANNEL=beta
VIBECODE_DEBUG=0

# ─── AI Provider API Keys (use staging/limited keys) ──────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Custom API Endpoints (optional) ──────────────────────────
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# ─── Workspace & Storage ──────────────────────────────────────
VIBECODE_WORKSPACE_DIR=~/.vibecode-preview/workspaces
VIBECODE_MEMORY_DIR=~/.vibecode-preview/memory
VIBECODE_SESSIONS_DIR=~/.vibecode-preview/sessions

# ─── Health Check (ON in preview mode) ────────────────────────
VIBECODE_HEALTH_PORT=9876

# ─── Watchdog ─────────────────────────────────────────────────
VIBECODE_HEALTH_URL=http://localhost:9876
WATCHDOG_INTERVAL_MS=15000

# ─── PM2 Process Name ─────────────────────────────────────────
PM2_PROCESS_NAME=vibecode-desktop
