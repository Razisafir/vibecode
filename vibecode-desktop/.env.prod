# ============================================================
# VibeCode Desktop — Production Environment
# ============================================================
# SAFETY: This file is ONLY used when VIBECODE_ENV=prod or when
# running in a production deployment. It is never auto-loaded.
#
# CRITICAL: This file should NEVER be committed with real values.
# Always use secrets management in production deployments.
# ============================================================

# ─── Application ───────────────────────────────────────────────
VIBECODE_ENV=prod
VIBECODE_CHANNEL=stable
VIBECODE_DEBUG=0

# ─── AI Provider API Keys (use production keys) ───────────────
# DO NOT set real keys here — use secrets management instead
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Custom API Endpoints (optional) ──────────────────────────
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# ─── Workspace & Storage ──────────────────────────────────────
VIBECODE_WORKSPACE_DIR=~/.vibecode/workspaces
VIBECODE_MEMORY_DIR=~/.vibecode/memory
VIBECODE_SESSIONS_DIR=~/.vibecode/sessions

# ─── Health Check (ON in production) ──────────────────────────
VIBECODE_HEALTH_PORT=9876

# ─── Watchdog ─────────────────────────────────────────────────
VIBECODE_HEALTH_URL=http://localhost:9876
WATCHDOG_INTERVAL_MS=30000

# ─── PM2 Process Name ─────────────────────────────────────────
PM2_PROCESS_NAME=vibecode-desktop
