# ============================================================
# VibeCode Desktop — Development Environment
# ============================================================
# SAFETY: This file is ONLY used when VIBECODE_ENV=dev or when
# running `npm run dev`. It is never auto-loaded in production.
# ============================================================

# ─── Application ───────────────────────────────────────────────
VIBECODE_ENV=dev
VIBECODE_CHANNEL=alpha
VIBECODE_DEBUG=1

# ─── AI Provider API Keys (fill in your own) ──────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Custom API Endpoints (optional) ──────────────────────────
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# ─── Workspace & Storage ──────────────────────────────────────
VIBECODE_WORKSPACE_DIR=~/.vibecode/workspaces
VIBECODE_MEMORY_DIR=~/.vibecode/memory
VIBECODE_SESSIONS_DIR=~/.vibecode/sessions

# ─── Development Server ───────────────────────────────────────
VITE_PORT=5173

# ─── Health Check (OFF by default in dev) ─────────────────────
# Set to a port number to enable the health check HTTP server
# VIBECODE_HEALTH_PORT=9876

# ─── Watchdog (OFF by default) ────────────────────────────────
# WATCHDOG_INTERVAL_MS=15000
# VIBECODE_HEALTH_URL=http://localhost:9876
