# VibeCode Desktop — Environment Variables
# Copy this to .env and fill in your values

# AI Provider API Keys (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: Custom API endpoints
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# Workspace
VIBECODE_WORKSPACE_DIR=~/.vibecode/workspaces

# Memory Store
VIBECODE_MEMORY_DIR=~/.vibecode/memory
